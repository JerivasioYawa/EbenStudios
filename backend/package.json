{
  "name": "backend",
  "version": "1.0.0",
  "description": "Eben Studios API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js",
    "test:verbose": "node --test --test-reporter=spec",
    "test:money": "node --test tests/phase4-money.test.js",
    "test:validation": "node --test tests/validation.test.js",
    "test:syntax": "node scripts/check-syntax.js",
    "test:all": "npm test && npm run test:syntax",
    "test:integration": "node --test tests/integration.test.js",
    "db:deploy": "node scripts/prepare-database.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
